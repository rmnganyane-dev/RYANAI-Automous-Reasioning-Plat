# ==========================================
# Stage 1: Web Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Build tools
RUN apk add --no-cache python3 make g++ build-base

# Copy package manifests safely
COPY package.json pnpm-lock.yaml* package-lock.json* pnpm-workspace.yaml* .npmrc* ./

# Copy repository source files
COPY . .

# Install dependencies
RUN pnpm install --frozen-lockfile || npm ci

# Build frontend bundle
RUN pnpm run build:client || pnpm run build

# ==========================================
# Stage 2: Production Nginx Runner
# ==========================================
FROM nginx:1.27-alpine

# Install runtime utilities
RUN apk add --no-cache gettext dumb-init

# Copy built static bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx configuration and entrypoint if available, or fall back gracefully
COPY nginx.conf* /etc/nginx/conf.d/default.conf

# Set up permissions for non-root nginx execution
RUN mkdir -p /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /usr/share/nginx/html /etc/nginx/conf.d

USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["nginx", "-g", "daemon off;"]