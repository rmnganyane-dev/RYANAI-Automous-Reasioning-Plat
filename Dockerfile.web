# ==========================================
# Stage 1: Build Frontend Assets
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package manifests and lockfile
COPY package.json pnpm-lock.yaml* package-load* ./

# Install Python, build tools, and local Node.js development headers
RUN apk add --no-cache python3 make g++ build-base nodejs-dev

# Tell node-gyp to use the local container headers instead of downloading them online
RUN npm config set nodedir /usr

# Install dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts || npm ci --ignore-scripts
RUN apk add --no-cache python3 make g++ nodejs-dev

# Copy source code and configuration
COPY . .

# Build Vite static bundle
RUN pnpm run build

# ==========================================
# Stage 2: Production Nginx Runtime
# ==========================================
FROM nginx:alpine

# Copy built artifacts from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx template for dynamic port routing
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]