{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "node --import tsx/esm src/server/index.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "docker:build": "docker compose build --no-cache",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "tauri": "tauri",
    "rust:fetch": "cargo fetch --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml --all-targets",
    "mcp:check": "npm --prefix mcp-server run check",
    "mcp:start": "npm --prefix mcp-server start",
    "release": "powershell -ExecutionPolicy Bypass -File ./build-installer.ps1",
    "ship": "npm run typecheck && npm run build && git add . && git commit -m \"ship: production build update\" && git push origin main"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tauri-apps/api": "^2.11.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}