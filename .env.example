# ==========================================
# RyanAI Environment Configuration Template
# ==========================================

# --- System & Network ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
VITE_APP_ENV=production
VITE_API_BASE_URL=http://localhost:3000
DEFAULT_CONTAINER=ryanai-runtime

# --- Database & Vector Store ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ryanai

# --- Caching & Redis ---
REDIS_URL=redis://localhost:6379

# --- Multi-Model Gateway Providers ---
VITE_NVIDIA_NEMOTRON_KEY=your_nvidia_nemotron_api_key_here
VITE_QWEN_API_KEY=your_qwen_api_key_here

# --- OpenAI & Gateway Integration ---
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_ORG_ID=org-optional_organization_id_here
OPENAI_PROJECT_ID=proj_optional_project_id_here

# --- LLM Inference & CUDA ---
LLM_PROVIDER=local
CUDA_DEVICE_ID=0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces