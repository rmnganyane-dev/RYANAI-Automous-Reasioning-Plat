# Supabase project settings
# Copy this file to .env.local and replace both values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Runtime and MCP configuration
PORT=9090
NODE_ENV=production
FASTIFY_PORT=3001
MCP_SERVER_TRANSPORT=stdio

# Optional provider credentials. Keep secrets in .env.local or deployment secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
QWEN_API_KEY=
CUDA_DEVICE_MODE=auto

# RyanAI dual-brain routing
PRIMARY_REASONING_MODEL=nvidia-nemotron-3-ultra
SECONDARY_REASONING_MODEL=qwen-3.6-27b
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
QWEN_API_ENDPOINT=https://api.together.xyz/v1
VITE_PRIMARY_REASONING_MODEL=nvidia/nemotron-3-ultra
VITE_SECONDARY_REASONING_MODEL=qwen/qwen-3.6-27b
VITE_NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
VITE_QWEN_API_ENDPOINT=https://api.together.xyz/v1

# Optional provider identity values for OAuth infrastructure
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
WHATSAPP_API_TOKEN=
