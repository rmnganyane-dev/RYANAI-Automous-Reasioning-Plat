# ==========================================
# RyanAI Environment Configuration Template
# ==========================================

# --- System & Network ---
NODE_ENV=production
PORT=9090
HOST=0.0.0.0
VITE_APP_ENV=production
VITE_API_URL="http://localhost:9090"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
DEFAULT_CONTAINER=ryanai-runtime

# --- Supabase Gateway ---
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Database & Vector Store ---
DB_PASSWORD=replace_with_unique_alphanumeric_secret_before_deployment
DATABASE_URL="postgresql://ryanai:sovereign_secret@localhost:5432/ryanai_db?schema=public"

# --- Caching & Redis ---
REDIS_PASSWORD=replace_with_a_different_unique_alphanumeric_secret
REDIS_URL=redis://localhost:6379

# --- Multi-Model Gateway Providers ---
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_TOGETHER_API_KEY=your_together_api_key_here
VITE_NVIDIA_NEMOTRON_KEY=your_nvidia_nemotron_api_key_here
VITE_QWEN_API_KEY=your_qwen_api_key_here

# --- OpenAI & Gateway Integration ---
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_ORG_ID=org-optional_organization_id_here
OPENAI_PROJECT_ID=proj_optional_project_id_here

# --- LLM Inference & CUDA ---
LLM_PROVIDER=local
CUDA_DEVICE_ID=0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4180/v1/traces

# Database
DATABASE_URL=postgresql://postgres:[REDACTED]@localhost:5432/ryanai
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=2000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT=5000

# Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# API Configuration
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# LLM Providers
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo
VITE_ANTHROPIC_API_KEY=sk-ant-...
VITE_GOOGLE_API_KEY=...

# Optional Services
NGROK_AUTHTOKEN=...                    # For webhook testing
MCP_ENABLED=true
MCP_PORT=8765
SENTRY_ENABLED=false
SENTRY_DSN=...
TAURI_ENABLED=false