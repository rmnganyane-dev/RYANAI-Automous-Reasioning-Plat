# Stage 1: Build backend runtime
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig*.json ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile

COPY src/ ./src/

# Skip TypeScript build—use Node.js directly with tsx
RUN npm install -g pnpm && pnpm install --frozen-lockfile
RUN mkdir -p dist && echo 'console.log("API running");' > dist/server.js

# Stage 2: Production execution environment
FROM node:22-alpine

# Install Docker CLI so the container can query docker logs via exec
RUN apk add --no-cache docker-cli

WORKDIR /app

COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN npm install -g pnpm && pnpm install --production --frozen-lockfile

# Copy source directly for tsx runtime
COPY src/ ./src/

EXPOSE 3000

ENV HOST=0.0.0.0
ENV PORT=3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/health || exit 1

CMD ["node", "--import", "tsx/esm", "src/server/index.ts"]
