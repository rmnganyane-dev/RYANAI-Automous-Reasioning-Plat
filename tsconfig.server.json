{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/server.ts",
    "src/server/**/*",
    "src/mcp/**/*",
    "src/db/**/*",
    "src/agent/**/*",
    "src/api/**/*",
    "src/index.ts"
  ]
}