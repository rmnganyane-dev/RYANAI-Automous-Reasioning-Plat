# ==========================================
# Stage 1: Build & Dependencies
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Build tools required for native C/C++ modules & node-gyp
RUN apk add --no-cache python3 make g++ build-base libc6-compat linux-headers

# Copy package manifests (wildcards safely ignore missing optional lockfiles)
COPY package.json pnpm-lock.yaml* package-lock.json* pnpm-workspace.yaml* ./

# Copy configuration files
COPY tsconfig*.json vite.config.* ./

# Copy source directories cleanly using shell execution
COPY . .

# Install workspace dependencies
RUN pnpm install --frozen-lockfile || pnpm install || npm ci

# Generate Prisma client if schema exists
RUN [ -f prisma/schema.prisma ] && pnpm prisma generate || true

# Build application bundle
RUN pnpm run build || pnpm run build:server || pnpm tsc -p tsconfig.json || true

# Prune dev dependencies for production
RUN pnpm prune --prod || npm prune --production

# ==========================================
# Stage 2: Production Runtime
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Install runtime utilities
RUN apk add --no-cache libstdc++ libc6-compat wget docker-cli dumb-init

# Create unprivileged system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 fastify

# Create required directories with correct permissions
RUN mkdir -p /app/logs /app/config && chown -R fastify:nodejs /app

# Copy built artifacts and dependencies from builder stage
COPY --from=builder --chown=fastify:nodejs /app/package.json ./
COPY --from=builder --chown=fastify:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=fastify:nodejs /app/dist ./dist

USER fastify

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/server/launcher.js"]