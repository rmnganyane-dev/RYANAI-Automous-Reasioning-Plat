FROM node:22-alpine AS dependencies

WORKDIR /app
RUN apk add --no-cache python3 make g++ libc6-compat
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

RUN apk add --no-cache dumb-init wget libstdc++ libc6-compat \
    && addgroup -S ryanai \
    && adduser -S -G ryanai ryanai \
    && mkdir -p /app/logs \
    && chown -R ryanai:ryanai /app

COPY --from=dependencies --chown=ryanai:ryanai /app/node_modules ./node_modules
COPY --chown=ryanai:ryanai package.json ./
COPY --chown=ryanai:ryanai src ./src
COPY --chown=ryanai:ryanai tsconfig.json tsconfig.base.json ./

USER ryanai
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "--import", "tsx/esm", "src/server/launcher.ts"]
